#!/usr/bin/env bash
# Host launcher for ghcr.io/novassist-ai/vpn-node-builder (Docker-hosted vpnb CLI).
#
# Installed as:
#   vpnb      → ghcr.io/novassist-ai/vpn-node-builder:latest  (prod)
#   vpnb-dev  → ghcr.io/novassist-ai/vpn-node-builder:dev     (dev tip)
#
# Override image: VPNB_IMAGE or VPN_NODE_BUILDER_IMAGE
# Host helpers (not forwarded into the container):
#   vpnb pull   | vpnb-dev pull   → docker pull (refresh tag)
#   vpnb update | vpnb-dev update → delete local image, then pull fresh
#   vpnb --version | -V           → brew/launcher version + docker image version

set -euo pipefail

REGISTRY_IMAGE="${VPNB_REGISTRY_IMAGE:-ghcr.io/novassist-ai/vpn-node-builder}"
# Set by Homebrew formula install; fall back to brew query or unknown.
VPNB_LAUNCHER_VERSION="${VPNB_LAUNCHER_VERSION:-}"

cmd=$(basename "$0")
case "${cmd}" in
  vpnb-dev*) default_tag=dev ;;
  *) default_tag=latest ;;
esac

IMAGE="${VPNB_IMAGE:-${VPN_NODE_BUILDER_IMAGE:-${REGISTRY_IMAGE}:${default_tag}}}"

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: Docker is required but was not found on PATH." >&2
  echo "Install Docker Desktop: https://docs.docker.com/get-docker/" >&2
  exit 1
fi

ensure_image() {
  if docker image inspect "${IMAGE}" >/dev/null 2>&1; then
    return 0
  fi
  echo "Image '${IMAGE}' not found locally; pulling..."
  docker pull "${IMAGE}"
}

launcher_version() {
  if [[ -n "${VPNB_LAUNCHER_VERSION}" ]]; then
    echo "${VPNB_LAUNCHER_VERSION}"
    return 0
  fi
  if command -v brew >/dev/null 2>&1; then
    local ver
    ver=$(brew list --versions vpn-node-builder 2>/dev/null | awk '{print $2; exit}') || true
    if [[ -n "${ver}" ]]; then
      echo "${ver}"
      return 0
    fi
  fi
  echo "unknown"
}

image_version() {
  local ver
  ver=$(docker image inspect "${IMAGE}" \
    --format '{{index .Config.Labels "org.opencontainers.image.version"}}' 2>/dev/null || true)
  if [[ -z "${ver}" || "${ver}" == "<no value>" ]]; then
    ver=$(docker image inspect "${IMAGE}" \
      --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
      | sed -n 's/^version=//p' | head -n1) || true
  fi
  if [[ -z "${ver}" ]]; then
    ver="unknown"
  fi
  echo "${ver}"
}

show_version() {
  ensure_image
  echo "launcher $(launcher_version)"
  echo "image    $(image_version) (${IMAGE})"
}

case "${1:-}" in
  pull)
    echo "Pulling ${IMAGE}..."
    exec docker pull "${IMAGE}"
    ;;
  update)
    echo "Updating ${IMAGE}..."
    if docker image inspect "${IMAGE}" >/dev/null 2>&1; then
      docker rmi -f "${IMAGE}" >/dev/null
    fi
    echo "Pulling ${IMAGE}..."
    exec docker pull "${IMAGE}"
    ;;
  --version|-V)
    show_version
    exit 0
    ;;
esac

ensure_image

extra_args=()
if [[ -t 0 && -t 1 ]]; then
  extra_args+=(-it)
fi

# Pass the host directory name so the in-container CLI can derive a stable
# workspace name (the /work mount hides the real folder name).
workspace_name="$(basename "$(pwd)")"

exec docker run --privileged --rm \
  ${extra_args[@]+"${extra_args[@]}"} \
  -p 4495:4495 -p 4495:4495/udp \
  -e "VPNB_WORKSPACE_NAME=${VPNB_WORKSPACE_NAME:-${workspace_name}}" \
  -v "$(pwd):/work" \
  -w /work \
  "${IMAGE}" \
  "$@"
