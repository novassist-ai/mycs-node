{
    "required_plugins": {
        "openstack": {
            "version": ">= 1.1.0",
            "source": "github.com/hashicorp/openstack"
        }
    },
    "variables": {
        "build_dir": "",
        "image_name": "",
        "image_version": "",
        "region": "",
        "tenant_id": "",
        "source_image_id": "",
        "flavor_id": "",
        "network_id": ""
    },
    "builders": [
        {
            "type": "openstack",
            "region": "{{user `region`}}",
            "tenant_id": "{{user `tenant_id`}}",
            "image_name": "{{user `image_name`}}",
            "source_image": "{{user `source_image_id`}}",
            "flavor": "{{user `flavor_id`}}",
            "ssh_username": "ubuntu",
            "ssh_ip_version": "4",
            "ssh_timeout": "45m",
            "networks": [
                "{{user `network_id`}}"
            ],
            "image_visibility": "private",
            "image_min_disk": 25,
            "force_delete": true,
            "metadata": {
                "distribution": "ubuntu",
                "hw_disk_bus": "scsi",
                "hw_scsi_model": "virtio-scsi",
                "hw_qemu_guest_agent": "yes",
                "image_original_user": "ubuntu",
                "os_type": "linux",
                "os_distro": "ubuntu",
                "mycs_bastion_version": "{{user `image_version`}}"
            }
        }
    ],
    "provisioners": [
        {
            "type": "file",
            "source": "{{user `build_dir`}}/.download",
            "destination": "/tmp/download"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/scripts/config",
            "destination": "/tmp/inceptor-scripts"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/www",
            "destination": "/tmp/www-static-home"
        },
        {
            "type": "shell",
            "expect_disconnect": "true",
            "inline_shebang": "/bin/bash -x",
            "execute_command": "chmod +x {{ .Path }}; {{ .Vars }} sudo -E sh '{{ .Path }}'",
            "inline": [
                "chmod +x /tmp/inceptor-scripts/*",
                "/tmp/inceptor-scripts/install_packages"
            ]
        }
    ]
}
