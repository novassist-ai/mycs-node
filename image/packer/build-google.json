{
    "required_plugins": {
        "googlecompute": {
            "version": ">= 1.0.0",
            "source": "github.com/hashicorp/googlecompute"
        }
    },
    "variables": {
        "gcp_acct_file": "{{env `GOOGLE_CREDENTIALS`}}",
        "gcp_project_id": "{{env `GOOGLE_PROJECT`}}",
        "gcp_zone": "{{env `GOOGLE_ZONE`}}",
        
        "source_image_family": "",

        "image_name": "",
        "publish_bucket": "",
        "publish_image_name": "",

        "build_dir": ""
    },
    "builders": [
        {
            "type": "googlecompute",
            "account_file": "{{user `gcp_acct_file`}}",
            "project_id": "{{user `gcp_project_id`}}",
            "zone": "{{user `gcp_zone`}}",
            "source_image_family": "{{user `source_image_family`}}",
            "ssh_username": "ubuntu",
            "image_family": "mycs-node-image",
            "image_name": "{{user `image_name`}}",
            "image_description": "MyCS bastion instance base image",
            "disk_size": 10
        }
    ],
    "provisioners": [
        {
            "type": "file",
            "source": "{{user `build_dir`}}/.download",
            "destination": "/tmp/download"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/scripts/config",
            "destination": "/tmp/inceptor-scripts"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/www",
            "destination": "/tmp/www-static-home"
        },
        {
            "type": "shell",
            "expect_disconnect": "true",
            "inline_shebang": "/bin/bash -x",
            "execute_command": "chmod +x {{ .Path }}; {{ .Vars }} sudo -E sh '{{ .Path }}'",
            "inline": [ 
                "chmod +x /tmp/inceptor-scripts/*",
                "/tmp/inceptor-scripts/install_packages" 
            ]
        }
    ],
    "post-processors": [
        {
          "type": "googlecompute-export",
          "paths": [
            "gs://{{user `publish_bucket`}}/mycs-node-image/{{user `publish_image_name`}}.tar.gz"
          ],
          "keep_input_artifact": true
        }
    ]
}