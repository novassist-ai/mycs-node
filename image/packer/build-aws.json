{
    "required_plugins": {
        "amazon": {
            "version": ">= 1.0.0",
            "source": "github.com/hashicorp/amazon"
        }
    },
    "variables": {
        "aws_access_key": "{{env `AWS_ACCESS_KEY_ID`}}",
        "aws_secret_key": "{{env `AWS_SECRET_ACCESS_KEY`}}",
        "region": "",
        "ami": "",
        "name": "",
        "build_dir": ""
    },
    "builders": [
        {
            "type": "amazon-ebs",
            "access_key": "{{user `aws_access_key`}}",
            "secret_key": "{{user `aws_secret_key`}}",
            "region": "{{user `region`}}",
            "source_ami": "{{user `ami`}}",
            "instance_type": "t4g.micro",
            "ssh_username": "ubuntu",
            "ami_name": "{{user `name`}}"
        }
    ],
    "provisioners": [
        {
            "type": "file",
            "source": "{{user `build_dir`}}/.download",
            "destination": "/tmp/download"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/scripts/config",
            "destination": "/tmp/inceptor-scripts"
        },
        {
            "type": "file",
            "source": "{{user `build_dir`}}/www",
            "destination": "/tmp/www-static-home"
        },
        {
            "type": "shell",
            "expect_disconnect": "true",
            "inline_shebang": "/bin/bash -x",
            "execute_command": "chmod +x {{ .Path }}; {{ .Vars }} sudo -E sh '{{ .Path }}'",
            "inline": [ 
                "chmod +x /tmp/inceptor-scripts/*",
                "/tmp/inceptor-scripts/install_packages" 
            ]
        }
    ]
}
